# Copy to .env.local and fill in. Never commit .env.local.
# The live values for this project are set in the Netlify site's
# environment variables (Site configuration > Environment variables).

# --- Airtable (data source) ---------------------------------------------
# Personal access token with read access to the base below.
AIRTABLE_API_KEY=
# Base holding the public profile and record tables.
AIRTABLE_BASE_ID=
# Table names within that base.
AIRTABLE_PUBLIC_PROFILES_TABLE=
AIRTABLE_PUBLIC_RECORDS_TABLE=

# --- Site ---------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs,
# sitemap.xml, robots.txt and OpenGraph image URLs.
# Production: https://serviceexperienceindex.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- API auth -----------------------------------------------------------
# Shared secret for POST /api/revalidate (on-demand ISR revalidation).
REVALIDATE_SECRET=
# Bearer token(s) for /api/agent/quote-requests. Accepts a comma-separated
# list, so several callers can hold distinct keys.
SEI_AGENT_KEY=
